// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id   Int    @id @default(autoincrement())
  name String
  role String 
  email String @unique
  googleId String?
  photoUrl String?
  password String? 
  buyscrips buyscrip[]
  sellscrips sellscrip[]
  buyscriphistory buyscriphistory[]
  sellscriphistory sellscriphistory[]
}

model buyscrip {
  id       Int      @id @default(autoincrement())
  name     String
  userid   Int 
  kitta    Int 
  wacc Decimal @db.Decimal(10,3)
  total Decimal @db.Decimal(10,3)
  relation user     @relation(fields: [userid], references: [id])
} 
model buyscriphistory {
  id       Int      @id @default(autoincrement())
  name     String
  userid   Int
  buyprice Decimal @db.Decimal(10,3) 
  kitta    Int
  buydatetime  DateTime 
  wacc Decimal @db.Decimal(10,3)
  total Decimal @db.Decimal(10,3)
  relation user     @relation(fields: [userid], references: [id])
} 
model sellscrip {
  id       Int      @id @default(autoincrement())
  name     String
  userid   Int 
  kitta    Int 
  wacc Decimal @db.Decimal(10,3)
  total Decimal @db.Decimal(10,3)
  profit Decimal @db.Decimal(10,3)
  relation user     @relation(fields: [userid], references: [id])
}
model sellscriphistory {
  id       Int      @id @default(autoincrement())
  name     String
  userid   Int
  sellprice Decimal @db.Decimal(10,3) 
  kitta    Int
  selldatetime  DateTime 
  wacc Decimal @db.Decimal(10,3)
  total Decimal @db.Decimal(10,3)
  profit Decimal @db.Decimal(10,3)
  relation user     @relation(fields: [userid], references: [id])
}
model tax{
  id Int @id @unique @default(autoincrement())
  sebComm  Decimal @db.Decimal(5,3)
  brComm Decimal @db.Decimal(5,3)
  dpCharge Int 
  shortTax Decimal @db.Decimal(5,3)
  longTax Decimal @db.Decimal(5,3)
  }