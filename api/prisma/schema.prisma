// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id   Int    @id @default(autoincrement())
  name String
  email String @unique
  googleId String?
  photoUrl String?
  password String?
  idToken String?
  scrips scrip[]
}

model scrip {
  id       Int      @id @default(autoincrement())
  name     String
  userid   Int
  buyprice Decimal @db.Decimal(10,3)
  sellprice Decimal @db.Decimal(10,3)
  kitta    Int
  buydatetime  DateTime
  selldatetime DateTime?
  wacc Decimal @db.Decimal(10,3)
  relation user     @relation(fields: [userid], references: [id])
}
model tax{
  id Int @id @unique @default(autoincrement())
  sebComm  Decimal @db.Decimal(5,3)
  brComm Decimal @db.Decimal(5,3)
  dpCharge Int 
  shortTax Decimal @db.Decimal(5,3)
  longTax Decimal @db.Decimal(5,3)
  }